<?xml version="1.0" encoding="utf-8"?>
<!-- Keine Cloud-Sicherung und keine Geräte-Übertragung durch Android: Zugangsdaten und Fahrdaten
     bleiben auf dem Gerät. Zum Umzug gibt es die eigene Sicherung (Einstellungen → Sicherung) oder den Sync. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
